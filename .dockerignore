QUICKSTART.sh
docker-setup.sh

# Node / React — npm install runs inside the Dockerfile; host node_modules must not shadow it
node_modules/
src/ui/node_modules/
src/ui/build/

# Build artifacts
dist/
build/
*.egg-info/
